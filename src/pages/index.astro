---
import Layout from '../layouts/Layout.astro';

const apps = [
	{
		name: 'PDF Editor',
		href: '/pdf-editor',
		description: 'Merge PDFs, fill in forms, add text and drawings. Runs entirely in your browser.',
	},
];
---

<Layout title="Quarris">
	<main>
		<h1>Quarris</h1>
		<p class="tagline">Tools and web apps.</p>
		<ul>
			{
				apps.map((app) => (
					<li>
						<a href={app.href}>
							<strong>{app.name}</strong>
							<span>{app.description}</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
	<footer>
		<a href="https://github.com/Quarris">GitHub</a>
	</footer>
</Layout>

<style>
	main,
	footer {
		max-width: 40rem;
		margin: 0 auto;
		padding: 0 1rem;
	}

	main {
		padding-top: 18vh;
		min-height: calc(100dvh - 4rem);
	}

	h1 {
		margin: 0;
		font-size: 2.5rem;
		letter-spacing: -0.03em;
	}

	.tagline {
		margin: 0.25rem 0 2.5rem;
		color: var(--muted);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}

	li a {
		display: grid;
		gap: 0.25rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--surface);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s;
	}

	li a:hover {
		border-color: var(--accent);
	}

	li span {
		color: var(--muted);
		font-size: 0.9rem;
	}

	footer {
		height: 4rem;
		display: flex;
		align-items: center;
		font-size: 0.875rem;
	}

	footer a {
		color: var(--muted);
	}
</style>
